# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEEPGRAM_API_KEY: Deepgram API key for transcription.
DEEPGRAM_API_KEY=""

# GEMINI_API_KEY: Google Gemini API key for AI copy/headline generation.
GEMINI_API_KEY=""
GEMINI_ENABLED="true"

# Speech generation is intentionally pinned to Gemini 3.1 Flash TTS.
# Do not silently fall back to another provider/model; audio quality changes are product-visible.
TTS_MODEL="gemini-3.1-flash-tts-preview"

# GROQ_API_KEY: Groq key for free-tier dialogue script generation.
GROQ_API_KEY=""
GROQ_ENABLED="true"

# OPENROUTER_API_KEY: OpenRouter key for free-model dialogue script generation fallback.
OPENROUTER_API_KEY=""
OPENROUTER_ENABLED="true"

# Lightweight bill shield for hosted AI routes.
# Use a long random secret in production so anonymous quota cookies cannot be forged.
AI_BILL_SHIELD_SECRET=""
AI_GENERATION_ENABLED="true"
BRAND_RESEARCH_ENABLED="true"
TRANSCRIPTION_ENABLED="true"
TTS_ENABLED="true"
DEEPGRAM_ENABLED="true"
# Production defaults are intentionally conservative.
# Local development defaults are much higher when these are unset.
AI_IP_DAILY_QUOTA="30"
BRAND_RESEARCH_DAILY_QUOTA="5"
AD_STREAM_DAILY_QUOTA="10"
DIALOGUE_SCRIPTS_DAILY_QUOTA="10"
DIALOGUE_AUDIO_DAILY_QUOTA="3"
HEADLINES_DAILY_QUOTA="10"
COPY_DAILY_QUOTA="10"
TRANSCRIPTION_DAILY_QUOTA="5"

# $1 paywall test. Anonymous users get two full website-to-ads runs before Checkout.
PAYWALL_ENABLED="true"
FREE_WORKFLOW_RUN_LIMIT="2"
PAID_PASS_PRICE_CENTS="100"
PAID_PASS_DAYS="7"
STRIPE_SECRET_KEY=""

# FIRECRAWL_API_KEY: Server-only key for researching a brand website.
FIRECRAWL_API_KEY=""

# TAVILY_API_KEY: Server-only key for outside-web brand research.
# ENABLE_TAVILY_RESEARCH must be true before Wiggly calls Tavily.
ENABLE_TAVILY_RESEARCH="false"
TAVILY_API_KEY=""

# Supabase powers hosted Wiggly share pages.
# Project: Wiggly (howclqjohkrvcdarajur)
VITE_SUPABASE_URL="https://howclqjohkrvcdarajur.supabase.co"
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL="https://howclqjohkrvcdarajur.supabase.co"
# Server-only. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""
