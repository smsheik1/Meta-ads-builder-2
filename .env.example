# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEEPGRAM_API_KEY: Deepgram API key for transcription.
DEEPGRAM_API_KEY=""

# GEMINI_API_KEY: Google Gemini API key for AI copy/headline generation.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: OpenRouter key for free-model dialogue script generation fallback.
OPENROUTER_API_KEY=""

# FIRECRAWL_API_KEY: Server-only key for researching a brand website.
FIRECRAWL_API_KEY=""

# TAVILY_API_KEY: Server-only key for outside-web brand research.
# ENABLE_TAVILY_RESEARCH must be true before Wiggly calls Tavily.
ENABLE_TAVILY_RESEARCH="false"
TAVILY_API_KEY=""

# Supabase powers hosted Wiggly share pages.
# Project: Wiggly (howclqjohkrvcdarajur)
VITE_SUPABASE_URL="https://howclqjohkrvcdarajur.supabase.co"
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL="https://howclqjohkrvcdarajur.supabase.co"
# Server-only. Never expose this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""
