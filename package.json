{
  "name": "wiggly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "tsx server.ts",
    "dev:server": "tsx watch server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "dev:legacy": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:web": "npm run dev -w @wiggly/web",
    "dev": "npm run dev:legacy",
    "build:legacy": "vite build",
    "build:web": "npm run build -w @wiggly/web",
    "build": "npm run build:legacy && npm run build:web",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint:legacy": "tsc --noEmit -p tsconfig.legacy.json",
    "lint:web": "npm run typecheck -w @wiggly/web",
    "lint": "npm run lint:legacy && npm run lint:web && npm run test:create-v2",
    "test:legacy": "playwright test",
    "test:create-v2": "npm run test -w @wiggly/web",
    "test": "npm run test:create-v2 && npm run test:legacy"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^2.2.0",
    "@remotion/bundler": "^4.0.462",
    "@remotion/renderer": "^4.0.462",
    "@sparticuz/chromium": "^148.0.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "dexie": "^4.4.3",
    "dotenv": "^17.2.3",
    "driver.js": "^1.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.15.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mp4-muxer": "^5.2.2",
    "multer": "^2.1.1",
    "papaparse": "^5.5.3",
    "puppeteer-core": "^24.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-moveable": "^0.56.0",
    "react-rnd": "^10.5.3",
    "react-selecto": "^1.26.3",
    "remotion": "^4.0.462",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
