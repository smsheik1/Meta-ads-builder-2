{
  "schemaVersion": "shaz-sequence-input-v1",
  "required": ["title", "sequence"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "required": ["poseId"],
        "properties": {
          "poseId": { "type": "string", "source": "poses/index.json" },
          "holdFrames": { "type": "integer", "minimum": 0, "maximum": 120, "default": 12 },
          "gapFrames": { "type": "integer", "minimum": 0, "maximum": 24, "default": 3 }
        }
      }
    }
  },
  "maximumOutputFrames": 1800,
  "notes": [
    "Pose IDs are registry entries, never arbitrary filesystem paths.",
    "Every action duration comes from its recipe; holds and separators are explicit input fields.",
    "No finished artist-rendered frame may be supplied as an input."
  ]
}
