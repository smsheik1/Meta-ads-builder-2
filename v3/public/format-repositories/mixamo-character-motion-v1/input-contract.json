{
  "schemaVersion": 1,
  "required": [
    "characterId",
    "motionId",
    "title"
  ],
  "properties": {
    "characterId": {
      "type": "string",
      "enum": [
        "spongebob",
        "squilliam",
        "mr-krabs",
        "patrick",
        "sonic-modern",
        "flynn-rider",
        "kermit-pirate",
        "kermit-sci-fi",
        "agent-p",
        "squidward",
        "mario",
        "olaf",
        "sandy",
        "aqua",
        "ratchet",
        "larry",
        "man-ray",
        "batman-animated"
      ]
    },
    "motionId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  },
  "additionalProperties": false
}
