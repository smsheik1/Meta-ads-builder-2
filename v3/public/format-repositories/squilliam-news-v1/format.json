  "inputContract": "input-contract.json",
  "outputContract": "output-contract.json",
  "compositionContract": "composition-contract.json",
  "components": [
    "instructions",
    "user-inputs",
    "fixed-character-assets",
    "replaceable-promotion-pack",
    "voice-and-pronunciations",
    "timeline-slots",
    "official-renderer",
    "quality-checks",
    "final-output"
  ]
}
