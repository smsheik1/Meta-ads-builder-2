# Required only when a run does not already contain narration audio.
FISH_STUDIO_APIKEY=

# Fish Audio reference model selected by the operator. Copy a packaged public
# preset from assets/voice-presets.json, or use an approved private clone locally.
# Patrick and Sandy have voice presets but are not selectable character models yet.
SQUILLIAM_VOICE_ID=

# Optional override when Chrome is installed elsewhere.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
