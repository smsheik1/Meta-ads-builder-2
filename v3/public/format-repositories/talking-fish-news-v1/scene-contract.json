{
  "format": "talking-fish-news",
  "preset": "talking-fish-news-report",
  "orientation": "vertical",
  "width": 1080,
  "height": 1920,
  "durationMs": { "minimum": 14000, "maximum": 24000 },
  "beats": [
    { "index": 1, "role": "hook", "mustStartWith": "Breaking news." },
    { "index": 2, "role": "what-happened" },
    { "index": 3, "role": "why-it-matters" },
    { "index": 4, "role": "punchline" }
  ],
  "fixedAssets": [
    "anchor mouth open",
    "anchor mouth closed",
    "underwater studio",
    "evidence frame",
    "desk",
    "news theme"
  ],
  "replaceableContent": [
    "source facts",
    "five concepts",
    "selected script",
    "four evidence images",
    "publisher link text"
  ],
  "audio": {
    "voiceTracks": 1,
    "musicBeds": 1,
    "captions": "exact approved words, no more than six words per caption"
  }
}
