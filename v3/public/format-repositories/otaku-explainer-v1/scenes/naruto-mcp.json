{
  "id": "naruto-mcp",
  "title": "Naruto explains MCP",
  "input": { "topic": "Model Context Protocol", "storyWorld": "Naruto", "cast": ["naruto", "kakashi", "orochimaru"] },
  "scenes": [
    { "id": "nm-01", "speaker": "naruto", "dialogue": "Kakashi Sensei... why can't every AI tool just share its stuff?", "background": "konoha", "estimatedDurationMs": 3900, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":56,"rotate":-2},{"asset":"kakashi","x":58,"bottom":4,"width":37}], "accent": "question" },
    { "id": "nm-02", "speaker": "kakashi", "dialogue": "Each tool guards its data like a different ninja village.", "background": "training-ground", "estimatedDurationMs": 3400, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "network" },
    { "id": "nm-03", "speaker": "naruto", "dialogue": "So Claude needs a new jutsu for every app?", "background": "naruto-forest", "estimatedDurationMs": 3000, "characters": [{"asset":"naruto","x":10,"bottom":2,"width":58},{"asset":"kakashi","x":60,"bottom":4,"width":35}], "accent": "question" },
    { "id": "nm-04", "speaker": "kakashi", "dialogue": "Exactly. One for files. One for Slack. One for a database.", "background": "konoha", "estimatedDurationMs": 3900, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "network" },
    { "id": "nm-05", "speaker": "orochimaru", "dialogue": "That is where MCP becomes interesting.", "background": "naruto-forest", "estimatedDurationMs": 2900, "characters": [{"asset":"orochimaru","x":10,"bottom":3,"width":53},{"asset":"naruto","x":60,"bottom":2,"width":38}], "accent": "network" },
    { "id": "nm-06", "speaker": "orochimaru", "dialogue": "Think of MCP as one scroll format every village can read.", "background": "training-ground", "estimatedDurationMs": 3600, "characters": [{"asset":"orochimaru","x":8,"bottom":3,"width":49},{"asset":"kakashi","x":56,"bottom":4,"width":38}], "accent": "network" },
    { "id": "nm-07", "speaker": "naruto", "dialogue": "The same scroll can ask for tools, files, and data?", "background": "konoha", "estimatedDurationMs": 3300, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":57},{"asset":"kakashi","x":59,"bottom":4,"width":36}], "accent": "question" },
    { "id": "nm-08", "speaker": "kakashi", "dialogue": "Yes. The AI is the shinobi asking for help.", "background": "naruto-forest", "estimatedDurationMs": 3200, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "network" },
    { "id": "nm-09", "speaker": "kakashi", "dialogue": "An MCP server is the village gate offering approved tools.", "background": "training-ground", "estimatedDurationMs": 3500, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "network" },
    { "id": "nm-10", "speaker": "orochimaru", "dialogue": "It tells the AI what exists and how to use it.", "background": "konoha", "estimatedDurationMs": 3300, "characters": [{"asset":"orochimaru","x":8,"bottom":3,"width":49},{"asset":"naruto","x":56,"bottom":2,"width":42}], "accent": "network" },
    { "id": "nm-11", "speaker": "naruto", "dialogue": "So I don't rebuild the road every time?", "background": "naruto-forest", "estimatedDurationMs": 2800, "characters": [{"asset":"naruto","x":10,"bottom":2,"width":58},{"asset":"kakashi","x":60,"bottom":4,"width":35}], "accent": "question" },
    { "id": "nm-12", "speaker": "kakashi", "dialogue": "Right. Add a server, and the AI gets new abilities.", "background": "training-ground", "estimatedDurationMs": 3400, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "network" },
    { "id": "nm-13", "speaker": "orochimaru", "dialogue": "But the village gate still decides what the AI may touch.", "background": "konoha", "estimatedDurationMs": 3600, "characters": [{"asset":"orochimaru","x":8,"bottom":3,"width":49},{"asset":"kakashi","x":56,"bottom":4,"width":38}], "accent": "network" },
    { "id": "nm-14", "speaker": "naruto", "dialogue": "One common rulebook... and many powerful jutsu.", "background": "naruto-forest", "estimatedDurationMs": 3100, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":59,"rotate":2},{"asset":"kakashi","x":60,"bottom":4,"width":35}], "accent": "network" },
    { "id": "nm-15", "speaker": "naruto", "dialogue": "Dattebayo... MCP is basically the ninja network for AI!", "background": "training-ground", "estimatedDurationMs": 3700, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":61,"rotate":-3},{"asset":"kakashi","x":61,"bottom":4,"width":35}], "accent": "duel" }
  ]
}
