{
  "id": "naruto-compilers",
  "title": "Naruto explains compilers versus interpreters",
  "input": { "topic": "Compilers versus interpreters", "storyWorld": "Naruto", "cast": ["naruto", "kakashi", "orochimaru"] },
  "scenes": [
    { "id": "nc-01", "speaker": "naruto", "dialogue": "Kakashi Sensei... if compilers and interpreters both translate code...", "background": "konoha", "estimatedDurationMs": 3900, "characters": [{"asset":"naruto","x":7,"bottom":2,"width":54,"rotate":-2},{"asset":"kakashi","x":56,"bottom":4,"width":39}], "accent": "question" },
    { "id": "nc-02", "speaker": "naruto", "dialogue": "Why do Python and C++ work so differently?!", "background": "naruto-forest", "estimatedDurationMs": 3100, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":56,"rotate":2},{"asset":"kakashi","x":58,"bottom":4,"width":37}], "accent": "question" },
    { "id": "nc-03", "speaker": "kakashi", "dialogue": "Because they execute jutsu differently, Naruto.", "background": "training-ground", "estimatedDurationMs": 3000, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":42}], "accent": "none" },
    { "id": "nc-04", "speaker": "orochimaru", "dialogue": "A compiler prepares the entire forbidden scroll before the battle begins.", "background": "naruto-forest", "estimatedDurationMs": 4300, "characters": [{"asset":"orochimaru","x":7,"bottom":3,"width":49},{"asset":"kakashi","x":55,"bottom":4,"width":39}], "accent": "compiler" },
    { "id": "nc-05", "speaker": "naruto", "dialogue": "So C++ works like a prepared jutsu?", "background": "konoha", "estimatedDurationMs": 3000, "characters": [{"asset":"naruto","x":12,"bottom":2,"width":59},{"asset":"kakashi","x":62,"bottom":4,"width":34}], "accent": "compiler" },
    { "id": "nc-06", "speaker": "kakashi", "dialogue": "Exactly. The compiler checks the whole program first.", "background": "training-ground", "estimatedDurationMs": 3200, "characters": [{"asset":"kakashi","x":7,"bottom":3,"width":48},{"asset":"naruto","x":53,"bottom":2,"width":45}], "accent": "compiler" },
    { "id": "nc-07", "speaker": "kakashi", "dialogue": "It turns everything into machine code, then runs it fast later.", "background": "konoha", "estimatedDurationMs": 3800, "characters": [{"asset":"kakashi","x":8,"bottom":3,"width":47},{"asset":"naruto","x":54,"bottom":2,"width":43}], "accent": "compiler" },
    { "id": "nc-08", "speaker": "orochimaru", "dialogue": "An interpreter is different. It reads instructions during battle...", "background": "naruto-forest", "estimatedDurationMs": 3900, "characters": [{"asset":"orochimaru","x":7,"bottom":3,"width":49},{"asset":"kakashi","x":56,"bottom":4,"width":38}], "accent": "interpreter" },
    { "id": "nc-09", "speaker": "orochimaru", "dialogue": "One step at a time.", "background": "training-ground", "estimatedDurationMs": 2300, "characters": [{"asset":"orochimaru","x":8,"bottom":3,"width":48},{"asset":"kakashi","x":57,"bottom":4,"width":37}], "accent": "interpreter" },
    { "id": "nc-10", "speaker": "kakashi", "dialogue": "Yes. Python often runs line by line with an interpreter.", "background": "konoha", "estimatedDurationMs": 3600, "characters": [{"asset":"kakashi","x":17,"bottom":3,"width":57},{"asset":"naruto","x":66,"bottom":2,"width":31}], "accent": "interpreter" },
    { "id": "nc-11", "speaker": "naruto", "dialogue": "Then why use interpreters at all?", "background": "naruto-forest", "estimatedDurationMs": 2700, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":56},{"asset":"kakashi","x":58,"bottom":4,"width":37}], "accent": "question" },
    { "id": "nc-12", "speaker": "orochimaru", "dialogue": "Because feedback is instant. If one hand sign fails, you see the error.", "background": "training-ground", "estimatedDurationMs": 4400, "characters": [{"asset":"orochimaru","x":7,"bottom":3,"width":48},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "interpreter" },
    { "id": "nc-13", "speaker": "kakashi", "dialogue": "Compilers catch many mistakes before the program runs.", "background": "konoha", "estimatedDurationMs": 3400, "characters": [{"asset":"kakashi","x":7,"bottom":3,"width":48},{"asset":"naruto","x":54,"bottom":2,"width":44}], "accent": "compiler" },
    { "id": "nc-14", "speaker": "orochimaru", "dialogue": "Interpreters find problems while the jutsu is already running.", "background": "naruto-forest", "estimatedDurationMs": 3600, "characters": [{"asset":"orochimaru","x":7,"bottom":3,"width":48},{"asset":"naruto","x":54,"bottom":2,"width":44}], "accent": "interpreter" },
    { "id": "nc-15", "speaker": "naruto", "dialogue": "So compile errors are failed hand signs before battle...", "background": "training-ground", "estimatedDurationMs": 3500, "characters": [{"asset":"naruto","x":10,"bottom":2,"width":60,"rotate":-2},{"asset":"kakashi","x":62,"bottom":4,"width":34}], "accent": "compiler" },
    { "id": "nc-16", "speaker": "naruto", "dialogue": "And runtime errors are jutsu failing mid-fight?!", "background": "konoha", "estimatedDurationMs": 3200, "characters": [{"asset":"naruto","x":10,"bottom":2,"width":60,"rotate":3},{"asset":"kakashi","x":62,"bottom":4,"width":34}], "accent": "interpreter" },
    { "id": "nc-17", "speaker": "orochimaru", "dialogue": "A compiler leaves you with one completed forbidden scroll.", "background": "naruto-forest", "estimatedDurationMs": 3400, "characters": [{"asset":"orochimaru","x":7,"bottom":3,"width":49},{"asset":"naruto","x":55,"bottom":2,"width":43}], "accent": "compiler" },
    { "id": "nc-18", "speaker": "naruto", "dialogue": "Dattebayo... programming languages are basically ninja fighting styles!", "background": "training-ground", "estimatedDurationMs": 4200, "characters": [{"asset":"naruto","x":8,"bottom":2,"width":61,"rotate":-3},{"asset":"kakashi","x":61,"bottom":4,"width":35}], "accent": "duel" }
  ]
}
